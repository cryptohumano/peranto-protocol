{
  "name": "dids-vc-ecotesting",
  "private": true,
  "version": "0.1.0",
  "description": "did:peranto — DID + VC registries for EVM/PVM (Paseo)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:paseo": "hardhat run scripts/deploy.ts --network paseo",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.0",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
