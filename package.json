{
  "name": "dids-vc-ecotesting",
  "private": true,
  "version": "0.1.0",
  "description": "did:peranto — DID + VC registries for EVM/PVM (Paseo)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:hardhat": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:paseo": "hardhat run scripts/deploy.ts --network paseo",
    "deploy:paseo:sync": "hardhat run scripts/deploy.ts --network paseo && npx tsx scripts/sync-aura-paseo-addresses.ts",
    "sync:aura-paseo": "npx tsx scripts/sync-aura-paseo-addresses.ts",
    "deploy:baseSepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:base": "hardhat run scripts/deploy.ts --network base",
    "deploy:arbitrumSepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "deploy:arbitrum": "hardhat run scripts/deploy.ts --network arbitrum",
    "cli": "tsx packages/cli/src/index.ts",
    "extension:build": "npm run build -w @peranto/aura-wallet",
    "extension:dev": "npm run dev -w @peranto/aura-wallet",
    "extension:pack": "npm run extension:build && mkdir -p releases && rm -f releases/aura-wallet.zip && (cd packages/extension/dist && zip -r ../../../releases/aura-wallet.zip .)",
    "web:dev": "npm run dev -w @peranto/web",
    "web:build": "npm run build -w @peranto/web",
    "schemas:register": "hardhat run scripts/register-schemas.ts",
    "seed:node": "hardhat run scripts/seed-node.ts",
    "smoke:paseo": "tsx scripts/smoke-economy.ts",
    "smoke:disco": "tsx scripts/smoke-disco-vertices.ts",
    "driver:dev": "npm run dev -w @peranto/uni-resolver-driver-did-peranto",
    "driver:build": "npm run build -w @peranto/sdk && npm run build -w @peranto/uni-resolver-driver-did-peranto"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
