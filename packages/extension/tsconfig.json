{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["chrome"],
    "paths": {
      "@peranto/sdk": ["../sdk/src/browser.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "manifest.config.ts"]
}
